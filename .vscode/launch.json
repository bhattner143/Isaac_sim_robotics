{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "🤖 LQR: Both Cart + Manip",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_lqr_min_effort_2d.py",
            "python": "/opt/anaconda3/envs/pydrake/bin/python",
            "args": [
                "--mode", "lqr-applied-to-both-cart-manip",
                "--duration", "10.0",
                "--target-x", "0.5",
                "--target-y", "0.0",
                "--horizon", "10.0"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "🎯 LQR: Manip Follows Cart",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_lqr_min_effort_2d.py",
            "python": "/opt/anaconda3/envs/pydrake/bin/python",
            "args": [
                "--mode", "lqr-applied-to-cart-manip-following-cart",
                "--duration", "10.0",
                "--target-x", "-1.0",
                "--target-y", "0.5",
                "--horizon", "10.0"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "👁️ Scene Viz",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_lqr_min_effort_2d.py",
            "python": "/opt/anaconda3/envs/pydrake/bin/python",
            "args": [
                "--mode", "scene-viz"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "🦿 Exo+SEA: Deactivated (passive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_tendon_with_exo_pydrake.py",
            "python": "/opt/anaconda3/envs/pydrake/bin/python",
            "args": [
                "--duration", "10.0",
                "--num-laps", "3"
            ],
            "env": { "KMP_DUPLICATE_LIB_OK": "TRUE" },
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "🦿 Exo+SEA: Activated at 5s",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_tendon_with_exo_pydrake.py",
            "python": "/opt/anaconda3/envs/pydrake/bin/python",
            "args": [
                "--exo-activate",
                "--exo-activate-time", "5.0",
                "--duration", "10.0",
                "--num-laps", "3"
            ],
            "env": { "KMP_DUPLICATE_LIB_OK": "TRUE" },
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "🦾 Isaac 5.1: Cart-Pendulum Controller",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cart_pendulum_manipulator_controller.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim/bin/python",
            "args": [
                "--mode", "coupled-motion"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim"
        },
        {
            "name": "🦾 Isaac 6.0: Cart-Pendulum Controller",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cart_pendulum_manipulator_controller.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim6/bin/python",
            "args": [
                "--mode", "coupled-motion"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim6"
        },
        {
            "name": "👁️ Isaac 5.1: Scene Viz (spring-damper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_with_spring_damper_scene_viz_isaac_sim.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim/bin/python",
            "args": [
                "--render", "native"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim"
        },
        {
            "name": "👁️ Isaac 6.0: Scene Viz (spring-damper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/script_cup_manipulator_pendulam_with_spring_damper_scene_viz_isaac_sim.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim6/bin/python",
            "args": [
                "--render", "native"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim6"
        },
        {
            "name": "🤖 PPO Train: Headless",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rl/train_ppo_residual.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim/bin/python",
            "args": [
                "--render", "headless",
                "--total-timesteps", "${input:totalTimesteps}",
                "--traj-type", "rect"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim"
        },
        {
            "name": "🤖 PPO Train: Native",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rl/train_ppo_residual.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim/bin/python",
            "args": [
                "--render", "native",
                "--total-timesteps", "${input:totalTimesteps}",
                "--traj-type", "rect"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim"
        },
        {
            "name": "📊 PPO Eval: Headless (select checkpoint)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rl/eval_ppo_residual.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim/bin/python",
            "args": [
                "--render", "headless",
                "--model", "${input:checkpointModel}",
                "--compare-baseline"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim"
        },
        {
            "name": "📊 PPO Eval: Native (select checkpoint)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rl/eval_ppo_residual.py",
            "python": "/home/morph-lab-ws-ubuntu-admin/anaconda3/envs/env_isaacsim/bin/python",
            "args": [
                "--render", "native",
                "--model", "${input:checkpointModel}",
                "--compare-baseline"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.isaacsim"
        }
    ],
    "inputs": [
        {
            "id": "totalTimesteps",
            "type": "pickString",
            "description": "Total training timesteps (~episodes = steps / 2000)",
            "options": [
                {"label": "50 episodes  (100 000 steps)",   "value": "100000"},
                {"label": "250 episodes (500 000 steps)",   "value": "500000"},
                {"label": "500 episodes (1 000 000 steps)", "value": "1000000"},
                {"label": "1000 episodes (2 000 000 steps)", "value": "2000000"}
            ],
            "default": "500000"
        },
        {
            "id": "checkpointModel",
            "type": "promptString",
            "description": "Path to PPO checkpoint (without .zip extension)",
            "default": "rl/checkpoints/ppo_residual_latest"
        }
    ]
}
